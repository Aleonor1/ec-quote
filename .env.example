# Calculatorul site-ului (sursa unica de pret). Secretul e QUOTE_SYNC_SECRET din calculator-app.
CALCULATOR_BASE_URL=https://calculator-app-production-a4cd.up.railway.app
CALCULATOR_SYNC_SECRET=
# Model (EC_QUOTE_MODEL gol = modelul implicit al modulului agent)
ANTHROPIC_API_KEY=
EC_QUOTE_MODEL=
# Shopify Admin (Draft Order)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
# CRM (optional). Cu CRM_BASE_URL gol, lead-ul si predarea nu se trimit nicaieri.
CRM_BASE_URL=
CRM_API_SECRET=

# Secretul cu care CRM-ul (si App Proxy-ul calculatorului) cheama acest backend. Minim 24 de caractere.
# Browserul nu il primeste niciodata: widgetul foloseste un token de sesiune semnat.
EC_QUOTE_INBOUND_SECRET=
# Optional: cheia pentru tokenuri de sesiune si linkuri de imagini. Goala = derivata din secretul de mai sus.
EC_QUOTE_SIGNING_SECRET=
EC_QUOTE_DATA_DIR=./data
# Adresa publica a acestui backend (baza linkurilor de imagini), de forma https://oferta.exemplu.ro
EC_QUOTE_PUBLIC_BASE_URL=

# Extensia Chrome (WhatsApp Web): perechi nume:token separate prin virgula, cate una de coleg.
# Token de minim 24 de caractere (openssl rand -hex 24). Goala = rutele /v1/assist/* refuza orice cerere.
EC_QUOTE_ASSIST_TOKENS=

# Gazdele de la care se descarca atasamentele trimise de CRM (virgula). Goala = niciun atasament.
EC_QUOTE_ATTACHMENT_HOSTS=
# Originile magazinului pentru chatul chemat direct din browser (virgula). Goala = nicio origine.
EC_QUOTE_CORS_ORIGINS=
# 1 = rutele /v1/chat/* accepta doar cereri venite prin App Proxy-ul calculatorului (cu secretul).
EC_QUOTE_CHAT_REQUIRE_SECRET=
# Cate proxy-uri de incredere sunt in fata (1 in spatele Caddy). 0 = se foloseste adresa conexiunii.
EC_QUOTE_TRUSTED_PROXY_HOPS=0
# 1 = pagina de proba a widgetului la /demo/ (doar local).
EC_QUOTE_DEMO=
# Limite optionale, cu valori implicite in ec_quote/config.py:
# EC_QUOTE_MAX_UPLOAD_MB, EC_QUOTE_MAX_ATTACHMENT_MB, EC_QUOTE_MAX_ATTACHMENTS, EC_QUOTE_ALLOWED_MIMES,
# EC_QUOTE_MEDIA_URL_TTL_SECONDS, EC_QUOTE_SESSION_TTL_SECONDS, EC_QUOTE_FETCH_TIMEOUT_SECONDS,
# EC_QUOTE_RATE_SESSIONS_PER_IP_HOUR, EC_QUOTE_RATE_MESSAGES_PER_SESSION_MINUTE,
# EC_QUOTE_RATE_MESSAGES_PER_IP_MINUTE, EC_QUOTE_RATE_UPLOADS_PER_SESSION_HOUR,
# EC_QUOTE_RATE_POLLS_PER_SESSION_MINUTE, EC_QUOTE_RATE_ASSIST_PER_TOKEN_MINUTE
